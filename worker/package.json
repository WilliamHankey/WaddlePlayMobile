{
  "name": "waddleplay-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "db:create": "wrangler d1 create waddleplay",
    "db:migrate:local": "wrangler d1 migrations apply waddleplay --local",
    "db:migrate:remote": "wrangler d1 migrations apply waddleplay --remote",
    "seed": "tsx scripts/seed.ts",
    "smoke": "node scripts/smoke.mjs",
    "cleanup": "tsx scripts/cleanup-test-data.ts",
    "cleanup:d1": "wrangler d1 execute waddleplay --remote --file scripts/cleanup-d1-users.sql"
  },
  "dependencies": {
    "@sanity/client": "^6.22.5",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.143.0"
  }
}
